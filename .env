# env-manager: a-better-me
# env-manager target: app-web format=ts path=.env.local generate=src/env.ts
# env-manager target: server format=ts path=.env.local generate=src/env.ts
# env-manager target: app-ios format=swift path=Config/LocalSecrets.xcconfig
# env-manager target: scripts format=ts path=.env.local generate=env.ts

# env-manager targets: app-web,app-ios
API_URL=http://127.0.0.1:6151 # {url}

# env-manager targets: app-web
CLIENT_PORT=6150 # {int:min(1),max(65535)}
CLIENT_HOST=a-better-me.localhost # {optional string}

# env-manager targets: server
API_PORT=6151 # {int:min(1),max(65535)}
# `production` in env-manager prod, `development` in dev. server/src/config.ts requires production-only secrets.
APP_ENV=development # {string:format(/^(development|production)$/)}
# The Bun dev server, scripts, and tests. Worktrees get their own local database through .env.override. The Worker reaches Postgres through its HYPERDRIVE binding instead.
DATABASE_URL= # {optional url}
# Where the server forwards /api/powersync/*. Empty means sync is off: the token route answers 503 and the app stays local.
POWERSYNC_URL= # {optional url}
# The Ed25519 private JWK (with kid) that signs PowerSync tokens. Empty locally: the server uses powersync/local/INSECURE-dev-jwt-key.json.
POWERSYNC_JWT_PRIVATE_KEY= # {optional string}
# The one credential: the app sends it as a bearer to get a sync token and to upload. Required in production.
OWNER_TOKEN= # {optional string}

# env-manager targets: scripts
# Provisioning and deploy credentials, shared with procrastimate's accounts. Never Worker bindings.
CLOUDFLARE_ACCOUNT_ID= # {optional string}
CLOUDFLARE_API_TOKEN= # {optional string}
SUPABASE_ACCESS_TOKEN= # {optional string}
POWERSYNC_ADMIN_TOKEN= # {optional string}
# Password of the a_better_me_powersync replication role in this environment's Supabase database.
POWERSYNC_DATABASE_PASSWORD= # {optional string}
# This environment's Supabase database as the a_better_me_app owner role, for migrations and inspection by hand. Prod's Worker uses Hyperdrive.
SUPABASE_DATABASE_URL= # {optional url}
