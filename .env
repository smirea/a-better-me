# env-manager: a-better-me
# env-manager target: app-web format=ts path=.env.local generate=src/env.ts
# env-manager target: server format=ts path=.env.local generate=src/env.ts
# env-manager target: app-ios format=swift path=Config/LocalSecrets.xcconfig
# env-manager target: scripts format=ts path=.env.local generate=env.ts

# env-manager targets: app-web,app-ios
API_URL=http://127.0.0.1:6151 # {url}

# env-manager targets: app-web
CLIENT_PORT=6150 # {int:min(1),max(65535)}
CLIENT_HOST=a-better-me.localhost # {optional string}

# env-manager targets: server
API_PORT=6151 # {int:min(1),max(65535)}
# `production` in env-manager prod, `development` in dev. server/src/config.ts requires production-only secrets.
APP_ENV=development # {string:format(/^(development|production)$/)}
# The one credential: the app sends it as a bearer on every sync. Required in production.
OWNER_TOKEN= # {optional string}
# Sentry project a-better-me-worker in org self-uo7. Empty turns reporting off; required in production.
SENTRY_DSN= # {optional url}
# Local verification knobs for snapshot paging and compaction. Unset uses the engine defaults; production refuses them.
SYNC_PAGE_SIZE= # {optional int:min(0)}
SYNC_RETENTION_MS= # {optional int:min(0)}
SYNC_COMPACT_EVERY_MS= # {optional int:min(0)}

# env-manager targets: app-ios
# Sentry project a-better-me-ios. Empty turns reporting off; Release takes prod's through `bun run env:ios`.
SENTRY_DSN_IOS= # {optional url}
# Read-only R2 credentials for the private a-better-me-assets bucket, URL included. Empty turns asset downloads off.
ASSETS_URL= # {optional url}
ASSETS_ACCESS_KEY_ID= # {optional string}
ASSETS_SECRET_ACCESS_KEY= # {optional string}

# env-manager targets: scripts
# Deploy credentials, shared with procrastimate's Cloudflare account. Never Worker bindings.
CLOUDFLARE_ACCOUNT_ID= # {optional string}
CLOUDFLARE_API_TOKEN= # {optional string}
