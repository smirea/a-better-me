#!/bin/zsh
# Drives a simulator's Device Hub window: sim [-d device] ui | tap <label> [n] | tapxy x y | tapfrac fx fy | swipe dir | type text | shot out.png
# The device defaults to $SIM_DEVICE. Screenshots go through simctl and need no window.
set -e
dir=${0:A:h}
if [[ "$1" == "shot" || ( "$1" == "-d" && "$3" == "shot" ) ]]; then
  [[ "$1" == "-d" ]] && { SIM_DEVICE=$2; shift 2; }
  udid=$(xcrun simctl list devices booted -j | bun -e "const d=await Bun.stdin.json(); const all=Object.values(d.devices).flat(); const m=all.filter(x=>x.name===process.argv[1]); if(m.length!==1){console.error('sim: '+m.length+' booted simulators named '+process.argv[1]); process.exit(1)} console.log(m[0].udid)" "$SIM_DEVICE")
  xcrun simctl io "$udid" screenshot "$2" >/dev/null 2>&1
  exit 0
fi
bin=$dir/../DerivedData/tools/sim
if [[ ! -x $bin || $dir/sim.swift -nt $bin ]]; then
  mkdir -p ${bin:h}
  swiftc -O $dir/sim.swift -o $bin
fi
exec $bin "$@"
