<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>API_URL</key>
    <string>$(API_URL)</string>
    <key>OWNER_TOKEN</key>
    <string>$(OWNER_TOKEN)</string>
    <key>NSHealthShareUsageDescription</key>
    <string>The Dashboard charts your body weight and daily steps from Health, and workouts read your heart rate and energy while you train.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Workouts are saved to Health with their heart rate and energy.</string>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
        <string>workout-processing</string>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.stefan.a-better-me</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>abetterme</string>
            </array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
