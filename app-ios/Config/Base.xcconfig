#include "LocalSecrets.xcconfig"
// The asset version every build downloads, written by `bun run assets version`.
#include "Assets.xcconfig"
// Release values from env-manager prod, written by `bun run env:ios`. Debug keeps LocalSecrets' API_URL, which carries
// the worktree's ports.
#include? "Env.xcconfig"

// Matches DEV_OWNER_TOKEN in server/src/config.ts, which every local server accepts.
OWNER_TOKEN[config=Debug] = insecure-local-dev-owner-token

// Debug downloads assets from the worktree's dev server, which serves app-ios/Assets, and never from the bucket, so
// env-manager values cannot route it there.
ASSETS_URL[config=Debug] = $(API_URL)/assets
ASSETS_ACCESS_KEY_ID[config=Debug] =
ASSETS_SECRET_ACCESS_KEY[config=Debug] =
