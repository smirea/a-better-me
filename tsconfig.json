{
	// pulled from bun init
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"types": ["bun"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		// "noUncheckedIndexedAccess": true, // annoying
		"noImplicitOverride": true,

		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,

		"paths": {
			"shared/*": ["./shared/*"]
		}
	},
	// The iOS build checks out its Swift packages under DerivedData, which ship JavaScript that allowJs would otherwise check.
	"exclude": ["node_modules", "app-ios/DerivedData", "app-ios/.build"]
}
