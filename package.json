{
	"name": "a-better-me",
	"private": true,
	"workspaces": [
		"server",
		"app-web"
	],
	"scripts": {
		"postinstall": "lefthook install",
		"lint": "oxlint --fix && oxfmt",
		"lint:ci": "oxlint && oxfmt --check",
		"typecheck": "bun run --cwd app-web build && bun check",
		"test": "bun test --pass-with-no-tests",
		"build": "bun run --cwd app-web build && bun build server/src/index.ts --target bun --outdir server/dist",
		"start": "concurrently --raw -k -s first \"bun run start:server\" \"bun run start:client\"",
		"start:client": "bun run --cwd app-web start",
		"start:server": "bun run --cwd server start",
		"start:ios": "bun app-ios/scripts/run",
		"dev": "bun run start",
		"client:dev": "bun run start:client",
		"server:dev": "bun run start:server",
		"env:generate": "env-manager gen --local",
		"pr:ship": "bun scripts/pr-ship.ts"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/router-plugin": "^1.168.48",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"concurrently": "^10.0.6",
		"es-toolkit": "^1.52.0",
		"kill-port-process": "^5.0.0",
		"lefthook": "^2.2.2",
		"lodash": "^4.18.1",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"env-manager": "github:smirea/env-manager#1b0393e4423946c0be7c6156d69974314cedb294"
	},
	"packageManager": "bun@1.4.4"
}
