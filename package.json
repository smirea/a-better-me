{
  "name": "a-better-me",
  "private": true,
  "workspaces": [
    "server",
    "app-web"
  ],
  "scripts": {
    "postinstall": "[ ! -d .git ] || lefthook install",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint && bun scripts/check-generated.ts",
    "typecheck": "bun check",
    "test": "bun test --pass-with-no-tests",
    "build": "bun update sync-engine && bun run --cwd app-web build && bun build server/src/index.ts --target bun --outdir server/dist && wrangler deploy --dry-run --outdir server/dist/worker",
    "start": "concurrently --raw -k -s first \"bun run start:server\" \"bun run start:client\"",
    "start:client": "bun run --cwd app-web start",
    "start:server": "bun run --cwd server start",
    "start:ios": "bun app-ios/scripts/run",
    "env:generate": "env-manager gen --local",
    "generate": "bun scripts/generate.ts",
    "motion": "bun exercise-motion/scripts/build.ts",
    "gym": "bun exercise-motion/scripts/gym-build.ts",
    "gym:fetch": "bun exercise-motion/scripts/gym-fetch.ts",
    "gym:debrand": "bun exercise-motion/scripts/gym-debrand.ts",
    "gym:serve": "bun exercise-motion/scripts/gym-serve.ts",
    "env:ios": "bun scripts/secrets.ts ios",
    "assets": "bun scripts/assets.ts",
    "secrets:push": "bun scripts/secrets.ts push",
    "secrets:github": "bun scripts/secrets.ts github",
    "secrets:check": "bun scripts/secrets.ts check"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.222.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/bun": "11.9.0",
    "@sentry/cloudflare": "11.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "drizzle-orm": "0.45.4",
    "lefthook": "^2.2.2",
    "oxlint": "^1.95.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sync-engine": "github:smirea/sync-engine",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@sentry/cli": "^3.8.2",
    "meshoptimizer": "^1.3.0",
    "wrangler": "^4.149.0"
  },
  "packageManager": "bun@1.4.4"
}
