{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": [
		"node_modules",
		".build",
		".swiftpm",
		"DerivedData",
		"dist",
		"build",
		"generated",
		"**/generated",
		"**/*.generated.ts",
		"**/*.gen.ts",
		"app-web/src/env.ts",
		"server/src/env.ts",
		"scripts/env.ts",
		"shared/catalog",
		"app-ios/Sources/App/Resources/Muscles.xcassets"
	],
	"printWidth": 120,
	"useTabs": true,
	"semi": true,
	"singleQuote": true,
	"trailingComma": "all",
	"arrowParens": "avoid",
	"jsxSingleQuote": true
}
